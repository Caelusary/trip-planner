# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project URL (Dashboard > Project Settings > API).
# Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Dashboard > Project Settings > API Keys).
# Safe to expose to the browser; row-level security enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenWeatherMap API key (https://home.openweathermap.org/api_keys).
# Server-only — no NEXT_PUBLIC_ prefix; used by lib/weather.ts for
# geocoding and 5-day forecasts. Never expose to the client.
OPENWEATHER_API_KEY=
