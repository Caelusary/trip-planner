# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project URL (Dashboard > Project Settings > API).
# Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Dashboard > Project Settings > API Keys).
# Safe to expose to the browser; row-level security enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenWeatherMap API key (https://home.openweathermap.org/api_keys).
# Server-only — no NEXT_PUBLIC_ prefix; used by lib/weather.ts for
# geocoding and 5-day forecasts. Never expose to the client.
OPENWEATHER_API_KEY=

# Sentry error tracking (Project Settings > Client Keys (DSN) on sentry.io).
# Safe to expose to the browser — a DSN only permits sending events, not
# reading data. Error reporting is a no-op if this is unset.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source map upload (build-time only, optional). SENTRY_ORG and
# SENTRY_PROJECT are your org/project SLUGS (visible in the sentry.io
# dashboard URL, not the numeric IDs from the DSN above). SENTRY_AUTH_TOKEN
# is server-only, never exposed to the client — generate one under Settings
# > Auth Tokens on sentry.io. Without all three, the build just skips
# source map upload; error reporting itself still works fine.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
